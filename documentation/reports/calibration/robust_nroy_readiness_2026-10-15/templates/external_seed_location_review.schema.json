{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "robust_nroy_external_seed_location_review/1.0.0",
  "title": "External seed-location review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "location_kind", "review_status", "reviewer", "reviewed_utc",
    "searched_locations", "searched_accounts_or_owners", "search_method",
    "search_started_utc", "search_completed_utc", "indexed_sources",
    "no_additional_source_basis"
  ],
  "properties": {
    "schema": {"const": "robust_nroy_external_seed_location_review/1.0.0"},
    "location_kind": {
      "enum": ["REMOTE_HPC", "CLOUD", "DELETED_LOCAL", "COLLABORATOR_HELD"]
    },
    "review_status": {"enum": ["COVERED", "REVIEWED_NONE"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "searched_locations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "searched_accounts_or_owners": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "search_method": {"type": "string", "minLength": 1},
    "search_started_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "search_completed_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"},
    "indexed_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "sha256", "disposition", "description"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "disposition": {"enum": ["IN_SCOPE", "REVIEWED_NON_SEED"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "no_additional_source_basis": {"type": ["string", "null"]}
  }
}
