      "lower_column_subtract_column": "CHILD (0-14) Low",
      "upper_column": "(All Age High)",
      "upper_column_subtract_column": "CHILD (0-14) High",
      "model_output": "new_infections",
      "target_family": "epidemic_backbone",
      "stages": ["backbone", "joint"],
