{
  "version": "1.0",
  "description": "Source-preserving mapping from Validation/DiseaseData.xlsx sheets to internal LHS calibration targets. Workbook columns are intentionally not renamed.",
  "targets": [
    {
      "name": "unaids_plhiv_all_ages",
      "sheet": "UNAIDS-PLHIV)",
      "year_column": "Time Period",
      "estimate_column": "(All Age Mid)",
      "lower_column": "(All Age Low)",
      "upper_column": "(All Age High)",
      "model_output": "PLHIV",
      "target_family": "epidemic_backbone",
      "stages": ["backbone", "joint"],
      "calibration_use": "primary",
      "weight": 2.0,
      "sigma_fallback_cv": 0.10,
      "filters": {
        "Indicator_GId": "PLWH",
        "Subgroup": "All ages estimate"
      }
    },
    {
      "name": "unaids_plhiv_female_adult_15plus",
      "sheet": "UNAIDS-PLHIV)",
      "year_column": "Time Period",
      "estimate_column": "(Female Age Mid)",
      "lower_column": "(Female Age Low)",
      "upper_column": "(Female Age High)",
      "model_output": "plhiv_female_15plus",
      "target_family": "plhiv_sex_composition",
      "stages": ["backbone", "joint"],
      "calibration_use": "secondary",
      "weight": 0.5,
      "sigma_fallback_cv": 0.12,
      "filters": {
        "Indicator_GId": "PLWH",
        "Subgroup": "All ages estimate"
      }
    },
    {
      "name": "unaids_plhiv_male_adult_15plus",
      "sheet": "UNAIDS-PLHIV)",
      "year_column": "Time Period",
      "estimate_column": "(Male Age Mid)",
