        "Population": "AIDS|Confirmed cases",
        "Indicator": "Reported cases",
        "Unit": "N"
      }
    },
    {
      "name": "unaids_art_stock_adult_15plus",
      "sheet": "UNAIDS-ART",
      "year_column": "Time Period",
      "estimate_column": "TOTAL ADULTS",
      "model_output": "on_art_stock",
      "target_family": "art_care",
      "stages": ["art", "joint"],
      "calibration_use": "secondary",
