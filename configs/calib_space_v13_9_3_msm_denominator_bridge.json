{
  "version": "1.3",
  "description": "V13.9.3 MSM denominator sensitivity diagnostic. Based on V13.7 joint space. Adds p_msm as a sampled parameter (0.053–0.090) to explore the MSM-risk denominator. The diagnosis target new_diagnoses_msm maps from MSM+Trans (CALC) but the model has no explicit trans compartment; this diagnostic tests whether a wider p_msm range can close the MSM diagnosis gap without adding a trans state.",
  "parameters": [
    {
      "name": "orient_female",
      "config_path": "transmission_model.groups.advanced.orientation_contact_multipliers.value.Female",
      "min": 0.2,
      "max": 1.0,
      "distribution": "uniform",
      "unit": "multiplier",
      "stages": ["joint"]
    },
    {
      "name": "orient_msm",
      "config_path": "transmission_model.groups.advanced.orientation_contact_multipliers.value.MSM",
      "min": 1.0,
      "max": 5.0,
      "distribution": "uniform",
      "unit": "multiplier",
      "stages": ["joint"]
    },
    {
      "name": "epsilon_hetero",
      "config_path": "transmission_model.mixing.epsilon_hetero.value",
      "min": 0.0,
      "max": 1.0,
      "distribution": "uniform",
      "unit": "dimensionless",
      "stages": ["joint"]
    },
    {
      "name": "epsilon_msm",
      "config_path": "transmission_model.mixing.epsilon_msm.value",
      "min": 0.0,
      "max": 1.0,
      "distribution": "uniform",
      "unit": "dimensionless",
      "stages": ["joint"]
    },
    {
      "name": "activity_med",
      "config_path": "population.activity_distribution.value.Medium",
      "min": 0.2,
      "max": 0.45,
      "distribution": "uniform",
      "unit": "proportion",
      "stages": ["joint"]
    },
    {
      "name": "activity_high",
      "config_path": "population.activity_distribution.value.High",
      "min": 0.03,
      "max": 0.15,
      "distribution": "uniform",
      "unit": "proportion",
      "derived_companion": {
        "name": "activity_low",
        "config_path": "population.activity_distribution.value.Low",
        "formula": "1.0 - activity_med - activity_high",
        "min": 0.14,
        "max": 0.81
      },
      "stages": ["joint"]
    },
    {
      "name": "seed_prevalence",
      "config_path": "population.epidemic_seed.seed_prevalence.value",
      "min": 0.001,
      "max": 0.0035,
      "distribution": "uniform",
      "unit": "proportion",
      "notes": "Total early seeded HIV stock. Widened around V13.6 candidates because diagnostics showed early AIDS deaths become reachable around 0.0028-0.0031, but this must be pulled back by other calibration targets.",
      "stages": ["joint"]
    },
    {
      "name": "seed_msm_fraction",
      "config_path": "population.epidemic_seed.msm_fraction.value",
      "min": 0.8,
      "max": 1.0,
      "distribution": "uniform",
      "unit": "proportion",
      "notes": "Early Dutch epidemic remains MSM-predominant; narrowed for pilot to avoid using heterosexual seed as a compensating artifact.",
      "stages": ["joint"]
    },
    {
      "name": "p_msm",
      "config_path": "population.p_msm.value",
      "min": 0.053,
      "max": 0.09,
      "distribution": "uniform",
      "unit": "proportion",
      "notes": "V13.9.3 MSM denominator diagnostic. Conservative range for modeled MSM-risk compartment; target new_diagnoses_msm is MSM+Trans (CALC), but model has no explicit trans compartment. Runner also syncs demography.sexual_debut.p_msm.value to keep population initialization and ongoing debut cohorts consistent.",
      "stages": ["joint"]
    },
    {
